# AI Journey Copilot - 后端配置
# 复制为 .env 并填入真实密钥

# ====== 高德地图 ======
AMAP_KEY=your_amap_api_key_here

# ====== 豆包语音（火山引擎） ======
# 通用 API Key（ASR/TTS 未单独配置时使用）
VOLCENGINE_API_KEY=your_volcengine_api_key_here

# ASR (语音识别，WebSocket 双向流式)
VOLCENGINE_ASR_API_KEY=
VOLCENGINE_ASR_URI=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
VOLCENGINE_ASR_RESOURCE_ID=volc.seedasr.sauc.duration

# TTS (语音合成，HTTP 非流式)
VOLCENGINE_TTS_API_KEY=
VOLCENGINE_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v1/tts
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
VOLCENGINE_TTS_SPEAKER=zh_female_shuangkuai_moon_bigtts

# ====== Claude (Anthropic) ======
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.7

# ====== Web Search（Claude 内置） ======
# 允许搜索的域名（逗号分隔，留空=不限制）
WEB_SEARCH_ALLOWED_DOMAINS=
# 屏蔽搜索的域名（逗号分隔）
WEB_SEARCH_BLOCKED_DOMAINS=
# 单次对话最大搜索次数
WEB_SEARCH_MAX_USES=5

# ====== Tavily Web Search ======
# Tavily 搜索 API Key（用于 POI web 召回等场景，当 Claude 内置 web_search 不可用时）
# 在 https://tavily.com 申请
TAVILY_API_KEY=
# 搜索深度：basic | advanced
TAVILY_SEARCH_DEPTH=basic
# 单次搜索最大返回结果数
TAVILY_MAX_RESULTS=10

# ====== 服务配置 ======
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ====== 日志 ======
LOG_LEVEL=info
